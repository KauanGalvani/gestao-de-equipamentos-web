@{
    Layout = "_Layout";
    ViewBag.title = "Edição de Fabricantes";
}

<form action="/Fabricante/Editar/@Model.Id" method="post">
    <div>
        <label for="Nome"></label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome">
    </div>

    <div>
        <label for="Email"></label>
        <br>
        <input type="email" name="Email" value="@Model.Email">
    </div>

    <div>
        <label for="Telefone"></label>
        <br>
        <input type="text" name="Telefone" value="@Model.Telefone">
    </div>

    <button type="submit">Confirmar</button>

</form>
