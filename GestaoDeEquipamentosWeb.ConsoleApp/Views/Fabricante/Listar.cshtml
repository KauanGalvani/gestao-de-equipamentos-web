@using GestaoDeEquipamentosWeb.ConsoleApp.Models;
@{
    Layout = "_Layout";
    ViewBag.title = "Listagem de fabricantes";
}

@model List<ListarFabricantesViewModel>;

<a class="btn-cadastrar" href="/Fabricante/Cadastrar">Cadastrar</a>

<table class="registros">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefones</th>
            <th>Editar</th>
            <th>Excluir</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarFabricantesViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td><a href="/Fabricante/Editar/@f.Id">Editar</a></td>
                <td><a href="/Fabricante/Excluir/@f.Id">Excluir</a></td>
            </tr>
        }
    </tbody>
</table>
