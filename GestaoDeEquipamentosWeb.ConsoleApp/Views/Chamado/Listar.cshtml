@{
    Layout = "_Layout";
    ViewBag.title = "Listagem de Chamados";
}

@model List<ListarChamadoViewModel>;

<a class="btn-cadastrar" asp-action="Cadastrar">Cadastrar</a>

<div class="filtros-listagem">
    <a class="@(string.IsNullOrWhiteSpace(ViewBag.statusSelecionado) ? "" : "ativo")" asp-action="listar">Todos</a>
    <a class="@(ViewBag.statusSelecionado == "em-aberto" ? "ativo" : "")" asp-action="listar"
       asp-route-status="em-aberto">Em Aberto</a>
    <a class="@(ViewBag.statusSelecionado == "concluidos" ? "ativo" : "")" asp-action="listar"
       asp-route-status="concluidos">Concluidos</a>
</div>

<table class=" registros">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Equipamento</th>
            <th>Data de Abertura</th>
            <th>Tempo Decorrido</th>
            <th>Status</th>
            <th>Editar</th>
            <th>Excluir</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarChamadoViewModel c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Titulo</td>
                <td>@c.Equipamento</td>
                <td>@c.DataAbertura.ToString(format: "dd/MM/yyyy")</td>
                <td>@c.TempoDecorrido dia(s)</td>
                <td>@(c.EstaConcluido ? "Concluido" : "Aberto")</td>
                <td><a asp-action="Editar" asp-route-id="@c.Id">Editar</a></td>
                <td><a asp-action="Excluir" asp-route-id="@c.Id">Excluir</a></td>
            </tr>
        }
    </tbody>
</table>